{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true
  },
   "include": [
    "Pages",
    "Fixtures",
    "utils",
    "Test-data",
    "tests",
    "playwright.config.ts"
  ]
}
